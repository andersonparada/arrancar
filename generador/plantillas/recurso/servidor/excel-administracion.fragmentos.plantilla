### importacionesExcelEnComposicion
import { crearIntercambio } from '../../core/intercambio/contexto.js';
import { validadorDeZod } from '../../core/intercambio/http/rutas-de-intercambio.js';
{{importacionesDeOpciones}}import type { {{Entidad}}Dto, SolicitudDe{{Entidad}} } from '../aplicacion/dto/{{entidadClave}}.dto.js';
import { columnasDe{{Plural}} } from '../http/{{pluralClave}}.columnas.js';
import { esquema{{Entidad}} } from '../http/{{pluralClave}}.esquemas-http.js';
### funcionDeIntercambioEnComposicion
/** Exportar e importar en Excel; cada fila importada pasa por las mismas reglas que el formulario. */
function intercambioDe{{Plural}}(casos: ReturnType<typeof casosDeUso>, {{dependenciasEnIntercambio}}: Dependencias) {
  return crearIntercambio<{{Entidad}}Dto, SolicitudDe{{Entidad}}>({
    nombre: '{{PluralTitulo}}',
    columnas: columnasDe{{Plural}}({{argumentoDeOpciones}}),
    validar: validadorDeZod(esquema{{Entidad}}),
    listar: (operador) => casos.listar.ejecutar(operador),
    crear: (operador, solicitud) => casos.crear.ejecutar(operador, solicitud),
  });
}

### argumentoDeIntercambioEnComposicion
, intercambioDe{{Plural}}(casos, dependencias)
### importacionDeIntercambioEnRutas
import { rutasDeIntercambio, type OpcionesDeIntercambio } from '../../core/intercambio/http/rutas-de-intercambio.js';
### constanteDeIntercambioEnRutas
const EN_EXCEL = {
  ruta: RUTA,
  archivo: '{{pluralClave}}',
  permisos: { importar: '{{permisoImportar}}', exportar: '{{permisoExportar}}' },
};
### parametroDeIntercambioEnRutas
  intercambio: OpcionesDeIntercambio['intercambio'],
### llamadaDeIntercambioEnRutas
    rutasDeIntercambio(app, { ...EN_EXCEL, intercambio });
### pruebasDeExcelEnApi
  it('lo exportado se puede revisar para importarlo de nuevo', async () => {
    await cuenta.propietario.post(RUTA, datos());
    const exportado = await cuenta.propietario.get(`${RUTA}/exportar`);

    const revision = await cuenta.propietario.subirImagen('POST', `${RUTA}/importar?ensayo=true`, {
      nombreArchivo: '{{pluralClave}}.xlsx',
      tipoMime: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
      contenido: exportado.cuerpo,
    });

    expect(exportado.estado).toBe(200);
    expect(revision.cuerpo).toMatchObject({ guardado: false, filas: expect.any(Number) });
  });
