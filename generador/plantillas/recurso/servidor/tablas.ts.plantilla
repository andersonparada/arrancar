import { {{importacionesPg}} } from 'drizzle-orm/pg-core';
import { idPrimario, marcasDeTiempo, politicaPor{{Alcance}} } from '../../../core/base-datos/columnas.js';
{{importacionTablaDelAlcance}}
import { esquema{{Modulo}} } from './esquema.tablas.js';
{{importacionesDeTablasReferidas}}
/** {{LosPlural}} de cada {{alcance}}; la seguridad por {{alcance}} (RLS) oculta las de otras. */
export const {{plural}} = esquema{{Modulo}}.table(
  '{{pluralSerpiente}}',
  {
    id: idPrimario(),
    {{alcance}}Id: uuid()
      .notNull()
      .references(() => {{tablaDelAlcance}}.id, { onDelete: 'cascade' }),
{{columnas}}
    ...marcasDeTiempo,
  },
  ({{parametroDeIndices}}) => [{{indices}}politicaPor{{Alcance}}()],
);
