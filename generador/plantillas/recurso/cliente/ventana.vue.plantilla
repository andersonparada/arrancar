<script setup lang="ts">
{{importacionDeOpcionesEnVentana}}import BotonBase from '@/modulos/core/componentes/BotonBase.vue';
import VentanaModal from '@/modulos/core/componentes/VentanaModal.vue';
import type { EdicionDe{{Entidad}} } from '../../composables/{{pluralClave}}/edicion-de-{{entidadClave}}';
import CamposDe{{Entidad}} from './CamposDe{{Entidad}}.vue';

defineProps<{ errores: Record<string, string>; enviando: boolean{{propDeReferencias}} }>();
const emit = defineEmits<{ cerrar: []; guardar: [] }>();
const edicion = defineModel<EdicionDe{{Entidad}}>({ required: true });
</script>

<template>
  <VentanaModal
    :abierta="edicion.abierta"
    :titulo="edicion.id ? '{{tituloEditar}}' : '{{tituloNuevo}}'"
    @cerrar="emit('cerrar')"
  >
    <form id="form-{{entidadClave}}" @submit.prevent="emit('guardar')">
      <CamposDe{{Entidad}} v-model="edicion" :errores="errores"{{referenciasEnCampos}} />
    </form>
    <template #pie>
      <BotonBase variante="secundario" @click="emit('cerrar')">Cancelar</BotonBase>
      <BotonBase tipo="submit" form="form-{{entidadClave}}" :cargando="enviando">Guardar</BotonBase>
    </template>
  </VentanaModal>
</template>
