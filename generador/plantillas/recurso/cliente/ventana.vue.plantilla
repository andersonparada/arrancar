<script setup lang="ts">
{{importacionesDeLaVentana}}import BotonBase from '@/modulos/core/componentes/BotonBase.vue';
import VentanaModal from '@/modulos/core/componentes/VentanaModal.vue';
import type { EdicionDe{{Entidad}} } from '../../composables/{{pluralClave}}/edicion-de-{{entidadClave}}';

defineProps<{ errores: Record<string, string>; enviando: boolean }>();
const emit = defineEmits<{ cerrar: []; guardar: [] }>();
const edicion = defineModel<EdicionDe{{Entidad}}>({ required: true });
</script>

<template>
  <VentanaModal
    :abierta="edicion.abierta"
