import { clienteHttp, type ClienteHttp } from '@/modulos/core/servicios/cliente-http';
import { intercambioDe } from '@/modulos/core/servicios/intercambio';

/** {{Singular}} tal como lo manda el servidor. */
export interface {{Entidad}} {
  id: string;
{{camposTs}}{{camposDeReferenciasEnTs}}
}

export type Datos{{Entidad}} = Omit<{{Entidad}}, 'id'{{omitirReferencias}}>;

const RUTA = '/{{moduloClave}}/{{pluralClave}}';

export class Api{{Plural}} {
  constructor(private readonly http: ClienteHttp) {}

  /** Exportar e importar en Excel. */
  get intercambio() {
    return intercambioDe(this.http, RUTA);
  }

  listar() {
    return this.http.obtener<{{Entidad}}[]>(RUTA);
  }

  obtener(id: string) {
    return this.http.obtener<{{Entidad}}>(`${RUTA}/${id}`);
  }

  crear(datos: Datos{{Entidad}}) {
    return this.http.crear<{{Entidad}}>(RUTA, datos);
  }

  actualizar(id: string, datos: Datos{{Entidad}}) {
    return this.http.reemplazar<{{Entidad}}>(`${RUTA}/${id}`, datos);
  }
{{eliminarEnApi}}}

export const api{{Plural}} = new Api{{Plural}}(clienteHttp);
