<script setup lang="ts">
import { Inbox, Plus } from 'lucide-vue-next';
import BotonBase from '@/modulos/core/componentes/BotonBase.vue';
import EncabezadoPagina from '@/modulos/core/componentes/EncabezadoPagina.vue';
import AccionesDeIntercambio from '@/modulos/core/componentes/intercambio/AccionesDeIntercambio.vue';
import VentanaDeImportacion from '@/modulos/core/componentes/intercambio/VentanaDeImportacion.vue';
import EstadoVacio from '@/modulos/core/componentes/EstadoVacio.vue';
import TarjetaDeRegistro from '@/modulos/core/componentes/TarjetaDeRegistro.vue';
import VentanaDe{{Entidad}} from '../componentes/{{pluralClave}}/VentanaDe{{Entidad}}.vue';
import { detallesDe{{Entidad}} } from '../composables/{{pluralClave}}/detalles-de-{{entidadClave}}';
{{importacionEliminarEnPagina}}import { usar{{Plural}} } from '../composables/{{pluralClave}}/usar-{{pluralClave}}';
import { VENTANAS_{{MODULO}} } from '../textos';

const ventana = VENTANAS_{{MODULO}}.{{plural}};
const PERMISOS_DE_INTERCAMBIO = { importar: '{{permisoImportar}}', exportar: '{{permisoExportar}}' };
const { registros, cargando, intercambio, {{cargarEnPagina}}{{referenciasEnPagina}}edicion, enviando, errores, abrir, guardar } = usar{{Plural}}();
{{eliminarEnPagina}}</script>

<template>
  <div>
    <EncabezadoPagina :titulo="ventana.titulo" :descripcion="ventana.descripcion">
      <AccionesDeIntercambio :permisos="PERMISOS_DE_INTERCAMBIO" @exportar="intercambio.exportar" @importar="intercambio.abrir" />
      <BotonBase v-permiso="'{{permisoGestionar}}'" :icono="Plus" @click="abrir()">{{ ventana.nuevo }}</BotonBase>
    </EncabezadoPagina>

    <p v-if="cargando" class="text-sm text-tierra-500">Cargando…</p>
    <EstadoVacio v-else-if="!registros.length" :icono="Inbox" titulo="Todavía no hay {{pluralTexto}}" />
    <ul v-else class="grid gap-3 md:grid-cols-2">
      <li v-for="registro in registros" :key="registro.id">
        <TarjetaDeRegistro
          :titulo="String(registro.{{campoMostrar}})"
          :detalles="detallesDe{{Entidad}}(registro)"
          permiso="{{permisoGestionar}}"
{{atributosDeLaTarjeta}}          @editar="abrir(registro)"
        />
      </li>
    </ul>

    <VentanaDe{{Entidad}}
      v-model="edicion"
{{referenciasEnVentana}}      :errores="errores"
      :enviando="enviando"
      @cerrar="edicion.abierta = false"
      @guardar="guardar"
    />
    <VentanaDeImportacion
      :estado="intercambio.estado"
      titulo="Importar {{pluralTexto}}"
      @elegir="intercambio.elegir"
      @plantilla="intercambio.bajarPlantilla"
      @importar="intercambio.importar"
      @cerrar="intercambio.cerrar"
    />
  </div>
</template>
