<script setup lang="ts">
import { useRouter } from 'vue-router';
import BotonBase from '@/modulos/core/componentes/BotonBase.vue';
import EncabezadoPagina from '@/modulos/core/componentes/EncabezadoPagina.vue';
import TarjetaBase from '@/modulos/core/componentes/TarjetaBase.vue';
import CamposDe{{Entidad}} from '../componentes/{{pluralClave}}/CamposDe{{Entidad}}.vue';
import { usarFormularioDe{{Entidad}} } from '../composables/{{pluralClave}}/usar-formulario-de-{{entidadClave}}';
import { VENTANAS_{{MODULO}} } from '../textos';

/** Alta y edición en página completa; sin `{{entidad}}Id` es {{unSingular}} nuev{{o}}. */
const props = defineProps<{ {{entidad}}Id?: string }>();

const router = useRouter();
const ventana = VENTANAS_{{MODULO}}.{{plural}};
const { edicion, cargando, enviando, errores, {{referenciasEnPagina}}guardar } = usarFormularioDe{{Entidad}}(
  props.{{entidad}}Id ?? null,
);
const volver = props.{{entidad}}Id
  ? { texto: 'Volver a la ficha', ruta: { name: '{{rutaNombre}}.ficha', params: { {{entidad}}Id: props.{{entidad}}Id } } }
  : { texto: `Volver a ${ventana.titulo}`, ruta: { name: '{{rutaNombre}}' } };

async function guardarYVerFicha(): Promise<void> {
  const guardado = await guardar();
  if (guardado) await router.push({ name: '{{rutaNombre}}.ficha', params: { {{entidad}}Id: guardado.id } });
}
</script>

<template>
  <form class="space-y-4" @submit.prevent="guardarYVerFicha">
    <EncabezadoPagina :titulo="{{entidad}}Id ? ventana.editar : ventana.nuevo" :volver="volver" />

    <p v-if="cargando" class="text-sm text-tierra-500">Cargando…</p>
    <TarjetaBase v-else>
      <CamposDe{{Entidad}} v-model="edicion" :errores="errores"{{referenciasEnCampos}} />
    </TarjetaBase>

    <div class="flex justify-end gap-2">
      <BotonBase variante="secundario" @click="router.push(volver.ruta)">Cancelar</BotonBase>
      <BotonBase tipo="submit" :cargando="enviando">Guardar</BotonBase>
    </div>
  </form>
</template>
