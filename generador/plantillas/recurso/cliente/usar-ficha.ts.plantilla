import { useRouter } from 'vue-router';
import { usarCarga } from '@/modulos/core/composables/usar-carga';
import { api{{Plural}}, type {{Entidad}} } from '../../servicios/{{pluralClave}}.api';
{{importacionEliminarEnFicha}}
/** La ficha {{delSingular}}: sus datos y lo que puede hacer con {{elSingular}} quien l{{o}} gestiona. */
export function usarFichaDe{{Entidad}}({{entidad}}Id: string) {
  const router = useRouter();
  const { datos: registro, cargando } = usarCarga(
    () => api{{Plural}}.obtener({{entidad}}Id),
    null as {{Entidad}} | null,
    'No se pudo cargar {{elSingular}}.',
  );
  const editar = () => router.push({ name: '{{rutaNombre}}.editar', params: { {{entidad}}Id } });
{{eliminarEnFicha}}
  return { registro, cargando, editar{{eliminarEnRetornoDeFicha}} };
}
