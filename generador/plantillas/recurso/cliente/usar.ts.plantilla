import { ref } from 'vue';
import { usarAvisos } from '@/modulos/core/almacenes/avisos';
import { usarCarga } from '@/modulos/core/composables/usar-carga';
{{importacionIntercambioEnUsar}}import { usarFormulario } from '@/modulos/core/composables/usar-formulario';
import { api{{Plural}}, type {{Entidad}} } from '../../servicios/{{pluralClave}}.api';
import { datosDe{{Entidad}}, edicionDe, type EdicionDe{{Entidad}} } from './edicion-de-{{entidadClave}}';
{{importacionDeReferencias}}
const SIN_REGISTROS: {{Entidad}}[] = [];

const guardar{{Entidad}} = (edicion: EdicionDe{{Entidad}}) =>
  edicion.id
    ? api{{Plural}}.actualizar(edicion.id, datosDe{{Entidad}}(edicion))
    : api{{Plural}}.crear(datosDe{{Entidad}}(edicion));

/** La ventana de {{losPlural}}: abrirla y guardar lo escrito, avisando y recargando la lista. */
function usarVentanaDe{{Plural}}(cargar: () => Promise<void>) {
  const avisos = usarAvisos();
  const { enviando, errores, enviar } = usarFormulario();
  const edicion = ref<EdicionDe{{Entidad}}>({ ...edicionDe(), abierta: false });

  function abrir({{entidad}}?: {{Entidad}}): void {
    edicion.value = edicionDe({{entidad}});
    errores.value = {};
  }

  async function guardar(): Promise<void> {
    const esNuevo = edicion.value.id === null;
    if (!(await enviar(() => guardar{{Entidad}}(edicion.value)))) return;
    avisos.exito(esNuevo ? '{{Singular}} registrad{{o}}.' : '{{Singular}} actualizad{{o}}.');
    edicion.value.abierta = false;
    await cargar();
  }

  return { edicion, enviando, errores, abrir, guardar };
}

/** {{LosPlural}} de {{laEmpresaOCuenta}}: listarlos, registrarlos y editarlos en una ventana. */
export function usar{{Plural}}() {
  const { datos: registros, cargando, cargar } = usarCarga(
    () => api{{Plural}}.listar(),
    SIN_REGISTROS,
    'No se pudieron cargar {{losPlural}}.',
  );
{{cargaDeReferencias}}  const ventana = usarVentanaDe{{Plural}}(cargar);
{{intercambioEnUsar}}
  return { registros, cargando, cargar, {{intercambioEnRetornoDeUsar}}{{referenciasEnRetorno}}...ventana };
}
