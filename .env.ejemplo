NODE_ENV=development
PUERTO=3100
URL_PUBLICA=http://localhost:5180

# Conexión de la aplicación (rol sin privilegios; las políticas RLS se aplican).
DATABASE_URL=postgres://arrancar_app:arrancar_app@localhost:5433/arrancar
# Conexión del dueño de las tablas, solo para migraciones y semillas.
DATABASE_URL_PROPIETARIO=postgres://arrancar:arrancar@localhost:5433/arrancar

RUTA_ALMACENAMIENTO=./almacenamiento
# qpdf 11 o posterior, para revisar los PDF subidos (ruta absoluta; por omisión /usr/bin/qpdf).
# Si el sistema trae una versión 10, use el binario oficial de https://github.com/qpdf/qpdf/releases.
RUTA_QPDF=/usr/bin/qpdf
DURACION_SESION_DIAS=30

# Usuario de soporte con superacceso que crea la semilla inicial.
SUPERACCESO_USUARIO=supergod
SUPERACCESO_CONTRASENA=cambiar-esta-contrasena
# Tarea diaria que borra los archivos sueltos (sin fila en la base) con más de 24 horas.
# Ponga false ANTES de restaurar una base más vieja que la carpeta de archivos.
DEPURAR_HUERFANOS=true

# Carga automática de los tipos de cambio del Banguat (vacío: apagada; encienda con true solo tras las comprobaciones C-1 a C-4). La URL, vacía, es la oficial.
CARGAR_TIPOS_DE_CAMBIO=
URL_TIPO_DE_CAMBIO_BANGUAT=

# Llave que cifra la contraseña del servidor de correo (AES-256-GCM): openssl rand -base64 32
# Guárdela también aparte (gestor de contraseñas): si se pierde solo hay que escribir otra vez la contraseña SMTP.
CLAVE_SECRETOS=
# La llave anterior, solo mientras se rota.
CLAVE_SECRETOS_ANTERIOR=
# Solo desarrollo (con Mailpit): permite un servidor de correo en la red interna. Se rechaza en producción.
CORREO_PERMITIR_RED_INTERNA=false
# Solo desarrollo (con Mailpit, `npm run bd:levantar`): los correos salen sin cifrado y sin credenciales a este servidor de
# mentira (bandeja en http://localhost:8025) en vez de al que guarda Soporte, que igual debe estar guardado y activo
# (cualquier dato sirve; hace falta CLAVE_SECRETOS). Se rechaza en producción: la app no arranca con ella.
CORREO_DESARROLLO_SERVIDOR=
CORREO_DESARROLLO_PUERTO=1025
