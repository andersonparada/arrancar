NODE_ENV=development
PUERTO=3100
URL_PUBLICA=http://localhost:5180

# Conexión de la aplicación (rol sin privilegios; las políticas RLS se aplican).
DATABASE_URL=postgres://arrancar_app:arrancar_app@localhost:5433/arrancar
# Conexión del dueño de las tablas, solo para migraciones y semillas.
DATABASE_URL_PROPIETARIO=postgres://arrancar:arrancar@localhost:5433/arrancar

RUTA_ALMACENAMIENTO=./almacenamiento
DURACION_SESION_DIAS=30

# Usuario de soporte con superacceso que crea la semilla inicial.
SUPERACCESO_USUARIO=supergod
SUPERACCESO_CONTRASENA=cambiar-esta-contrasena
