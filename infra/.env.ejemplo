# Copie este archivo como infra/.env en el servidor y cambie todos los valores.
# Use contraseñas solo con letras y números (van dentro de una URL de conexión).

DOMINIO=arrancar.midominio.com
POSTGRES_PASSWORD=cambie-esto-por-una-clave-larga
ARRANCAR_APP_PASSWORD=cambie-esto-por-otra-clave-larga

# Usuario de soporte; se crea con: docker compose exec app node dist/modulos/core/base-datos/sembrar.js
SUPERACCESO_USUARIO=supergod
SUPERACCESO_CONTRASENA=una-contrasena-de-al-menos-12-caracteres

# Configuración propia de este servidor (opcional). Ponga el archivo en infra/config/.
# RUTA_CONFIG_INSTALACION=/config/instalacion.json

# Respaldos diarios: cuántos días se conservan. Además se guarda el respaldo del
# día 1 de cada mes en respaldos/mensuales, durante MESES_RETENCION_MENSUAL meses
# (60 = 5 años). Cópielos fuera del servidor (docs/PLAN.md, «Respaldos»).
DIAS_RETENCION=14
MESES_RETENCION_MENSUAL=60
