# Copie este archivo como infra/.env en el servidor y cambie todos los valores.
# Use contraseñas solo con letras y números (van dentro de una URL de conexión).

DOMINIO=arrancar.midominio.com
POSTGRES_PASSWORD=cambie-esto-por-una-clave-larga
ARRANCAR_APP_PASSWORD=cambie-esto-por-otra-clave-larga

# Usuario de soporte; se crea con: docker compose exec app node dist/modulos/core/base-datos/sembrar.js
SUPERACCESO_USUARIO=supergod
SUPERACCESO_CONTRASENA=una-contrasena-de-al-menos-12-caracteres

# Configuración propia de este servidor (opcional). Ponga el archivo en infra/config/.
# RUTA_CONFIG_INSTALACION=/config/instalacion.json

# Respaldos diarios: cuántos días se conservan. Además se guarda el respaldo del
# día 1 de cada mes en respaldos/mensuales, durante MESES_RETENCION_MENSUAL meses
# (60 = 5 años). Cópielos fuera del servidor (docs/PLAN.md, «Respaldos»).
DIAS_RETENCION=14
MESES_RETENCION_MENSUAL=60

# Tarea diaria que borra archivos sueltos. Ponga false ANTES de restaurar una base más vieja que los archivos.
DEPURAR_HUERFANOS=true

# Carga automática de los tipos de cambio del Banguat (vacío: apagada; encienda con true solo tras las comprobaciones C-1 a C-4). La URL, vacía, es la oficial.
CARGAR_TIPOS_DE_CAMBIO=
URL_TIPO_DE_CAMBIO_BANGUAT=
# Correo (aviso de pago al proveedor). OBLIGATORIA para enviar correos: cifra la contraseña del servidor SMTP que
# guarda Soporte (AES-256-GCM). Genérela UNA vez con:  openssl rand -base64 32
# Respáldela aparte, fuera del servidor y de los respaldos de la base (gestor de contraseñas): quien tenga la base y la
# llave puede leer la contraseña SMTP. Si se pierde, no se pierde nada más: Soporte vuelve a escribir esa contraseña.
# Si falta y ya hay un servidor guardado, la app arranca pero lo dice como error en el registro (docker compose logs app).
CLAVE_SECRETOS=
# Solo al rotar la llave: ponga aquí la vieja y en CLAVE_SECRETOS la nueva; lo cifrado con la vieja se vuelve a cifrar
# solo (Soporte -> Correo, probar) y luego se borra esta línea.
CLAVE_SECRETOS_ANTERIOR=
