      "checkConstraints": {
        "anticipos_numero_positivo": {
          "name": "anticipos_numero_positivo",
          "value": "\"cuentas_por_liquidar\".\"anticipos\".\"numero\" > 0"
        },
        "anticipos_beneficiario_valido": {
          "name": "anticipos_beneficiario_valido",
          "value": "\"cuentas_por_liquidar\".\"anticipos\".\"beneficiario\" is not null and (\"cuentas_por_liquidar\".\"anticipos\".\"beneficiario\" is null or (char_length(\"cuentas_por_liquidar\".\"anticipos\".\"beneficiario\") between 1 and 150 and \"cuentas_por_liquidar\".\"anticipos\".\"beneficiario\" = btrim(\"cuentas_por_liquidar\".\"anticipos\".\"beneficiario\")))"
        },
        "anticipos_clase_valida": {
          "name": "anticipos_clase_valida",
          "value": "\"cuentas_por_liquidar\".\"anticipos\".\"clase\" in ('viatico', 'compra', 'otro')"
        },
        "anticipos_descripcion_valida": {
          "name": "anticipos_descripcion_valida",
          "value": "\"cuentas_por_liquidar\".\"anticipos\".\"descripcion\" is not null and (\"cuentas_por_liquidar\".\"anticipos\".\"descripcion\" is null or (char_length(\"cuentas_por_liquidar\".\"anticipos\".\"descripcion\") between 1 and 300 and \"cuentas_por_liquidar\".\"anticipos\".\"descripcion\" = btrim(\"cuentas_por_liquidar\".\"anticipos\".\"descripcion\")))"
        },
        "anticipos_monto_positivo": {
          "name": "anticipos_monto_positivo",
          "value": "\"cuentas_por_liquidar\".\"anticipos\".\"monto\" > 0"
        },
        "anticipos_liquidacion_posterior": {
          "name": "anticipos_liquidacion_posterior",
          "value": "\"cuentas_por_liquidar\".\"anticipos\".\"fecha_de_liquidacion\" is null or \"cuentas_por_liquidar\".\"anticipos\".\"fecha_de_liquidacion\" >= \"cuentas_por_liquidar\".\"anticipos\".\"fecha\""
        },
        "anticipos_fecha_limite_valida": {
          "name": "anticipos_fecha_limite_valida",
          "value": "\"cuentas_por_liquidar\".\"anticipos\".\"fecha_limite\" >= \"cuentas_por_liquidar\".\"anticipos\".\"fecha\""
        },
        "anticipos_forma_valida": {
          "name": "anticipos_forma_valida",
          "value": "\"cuentas_por_liquidar\".\"anticipos\".\"forma\" in ('cheque', 'nota_de_debito')"
        },
        "anticipos_motivo_con_vencidos_valido": {
          "name": "anticipos_motivo_con_vencidos_valido",
          "value": "(\"cuentas_por_liquidar\".\"anticipos\".\"motivo_con_vencidos\" is null or (char_length(\"cuentas_por_liquidar\".\"anticipos\".\"motivo_con_vencidos\") between 1 and 300 and \"cuentas_por_liquidar\".\"anticipos\".\"motivo_con_vencidos\" = btrim(\"cuentas_por_liquidar\".\"anticipos\".\"motivo_con_vencidos\")))"
        },
        "anticipos_estado_valido": {
          "name": "anticipos_estado_valido",
          "value": "\"cuentas_por_liquidar\".\"anticipos\".\"estado\" in ('abierto', 'liquidado', 'anulado')"
        },
        "anticipos_liquidacion_completa": {
          "name": "anticipos_liquidacion_completa",
          "value": "(\"cuentas_por_liquidar\".\"anticipos\".\"estado\" = 'liquidado') = (\"cuentas_por_liquidar\".\"anticipos\".\"fecha_de_liquidacion\" is not null) and (\"cuentas_por_liquidar\".\"anticipos\".\"fecha_de_liquidacion\" is not null) = (\"cuentas_por_liquidar\".\"anticipos\".\"liquidado_en\" is not null) and (\"cuentas_por_liquidar\".\"anticipos\".\"liquidado_en\" is not null) = (\"cuentas_por_liquidar\".\"anticipos\".\"liquidado_por\" is not null)"
        },
        "anticipos_abierto_sin_liquidar": {
          "name": "anticipos_abierto_sin_liquidar",
          "value": "\"cuentas_por_liquidar\".\"anticipos\".\"estado\" = 'liquidado' or (\"cuentas_por_liquidar\".\"anticipos\".\"devuelto\" = 0 and \"cuentas_por_liquidar\".\"anticipos\".\"reembolsado\" = 0 and \"cuentas_por_liquidar\".\"anticipos\".\"no_liquidado\" = 0 and \"cuentas_por_liquidar\".\"anticipos\".\"movimiento_de_devolucion_id\" is null and \"cuentas_por_liquidar\".\"anticipos\".\"movimiento_de_reembolso_id\" is null)"
        },
        "anticipos_montos_liquidados_validos": {
          "name": "anticipos_montos_liquidados_validos",
          "value": "\"cuentas_por_liquidar\".\"anticipos\".\"devuelto\" >= 0 and \"cuentas_por_liquidar\".\"anticipos\".\"reembolsado\" >= 0 and \"cuentas_por_liquidar\".\"anticipos\".\"no_liquidado\" >= 0"
        },
        "anticipos_devolucion_con_deposito": {
          "name": "anticipos_devolucion_con_deposito",
          "value": "(\"cuentas_por_liquidar\".\"anticipos\".\"devuelto\" > 0) = (\"cuentas_por_liquidar\".\"anticipos\".\"movimiento_de_devolucion_id\" is not null)"
        },
        "anticipos_reembolso_con_movimiento": {
          "name": "anticipos_reembolso_con_movimiento",
          "value": "(\"cuentas_por_liquidar\".\"anticipos\".\"reembolsado\" > 0) = (\"cuentas_por_liquidar\".\"anticipos\".\"movimiento_de_reembolso_id\" is not null)"
        },
        "anticipos_reembolso_sin_sobrante": {
          "name": "anticipos_reembolso_sin_sobrante",
          "value": "\"cuentas_por_liquidar\".\"anticipos\".\"reembolsado\" = 0 or (\"cuentas_por_liquidar\".\"anticipos\".\"devuelto\" = 0 and \"cuentas_por_liquidar\".\"anticipos\".\"no_liquidado\" = 0)"
        },
        "anticipos_liquidacion_no_pasa_del_monto": {
          "name": "anticipos_liquidacion_no_pasa_del_monto",
          "value": "\"cuentas_por_liquidar\".\"anticipos\".\"devuelto\" + \"cuentas_por_liquidar\".\"anticipos\".\"no_liquidado\" <= \"cuentas_por_liquidar\".\"anticipos\".\"monto\""
        },
        "anticipos_destino_valido": {
          "name": "anticipos_destino_valido",
          "value": "\"cuentas_por_liquidar\".\"anticipos\".\"destino_de_no_liquidado\" is null or \"cuentas_por_liquidar\".\"anticipos\".\"destino_de_no_liquidado\" in ('cobrar', 'renta_del_trabajo', 'perdida')"
        },
        "anticipos_destino_de_lo_no_liquidado": {
          "name": "anticipos_destino_de_lo_no_liquidado",
          "value": "(\"cuentas_por_liquidar\".\"anticipos\".\"no_liquidado\" > 0) = (\"cuentas_por_liquidar\".\"anticipos\".\"destino_de_no_liquidado\" is not null)"
        },
        "anticipos_renta_solo_de_empleados": {
          "name": "anticipos_renta_solo_de_empleados",
          "value": "\"cuentas_por_liquidar\".\"anticipos\".\"destino_de_no_liquidado\" is distinct from 'renta_del_trabajo' or \"cuentas_por_liquidar\".\"anticipos\".\"es_empleado\""
        },
        "anticipos_cuotas_solo_al_cobrar": {
          "name": "anticipos_cuotas_solo_al_cobrar",
          "value": "\"cuentas_por_liquidar\".\"anticipos\".\"cuotas\" is null or (\"cuentas_por_liquidar\".\"anticipos\".\"destino_de_no_liquidado\" = 'cobrar' and \"cuentas_por_liquidar\".\"anticipos\".\"cuotas\" >= 1)"
        },
        "anticipos_motivo_de_lo_no_liquidado": {
          "name": "anticipos_motivo_de_lo_no_liquidado",
          "value": "(\"cuentas_por_liquidar\".\"anticipos\".\"no_liquidado\" > 0) = (\"cuentas_por_liquidar\".\"anticipos\".\"motivo_de_no_liquidado\" is not null)"
        },
        "anticipos_motivo_de_lo_no_liquidado_rango": {
          "name": "anticipos_motivo_de_lo_no_liquidado_rango",
          "value": "(\"cuentas_por_liquidar\".\"anticipos\".\"motivo_de_no_liquidado\" is null or (char_length(\"cuentas_por_liquidar\".\"anticipos\".\"motivo_de_no_liquidado\") between 1 and 300 and \"cuentas_por_liquidar\".\"anticipos\".\"motivo_de_no_liquidado\" = btrim(\"cuentas_por_liquidar\".\"anticipos\".\"motivo_de_no_liquidado\")))"
        },
