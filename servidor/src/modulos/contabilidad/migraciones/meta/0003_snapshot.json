          "value": "\"contabilidad\".\"cuentas\".\"clase_de_flujo\" is null or \"contabilidad\".\"cuentas\".\"clase_de_flujo\" in ('efectivo', 'operacion', 'inversion', 'financiamiento', 'ninguna')"
        },
        "cuentas_tratamiento_fiscal_valido": {
          "name": "cuentas_tratamiento_fiscal_valido",
          "value": "\"contabilidad\".\"cuentas\".\"tratamiento_fiscal\" in ('deducible', 'no_deducible', 'exento', 'costo_de_renta_exenta', 'renta_de_capital', 'no_aplica')"
        },
