      "checkConstraints": {
        "activos_tipo_de_registro": {
          "name": "activos_tipo_de_registro",
          "value": "\"activos_fijos\".\"activos\".\"tipo_de_registro\" in ('activo', 'bien_de_control', 'de_terceros')"
        },
        "activos_origen": {
          "name": "activos_origen",
          "value": "\"activos_fijos\".\"activos\".\"origen\" in ('compra', 'construccion', 'importacion', 'aporte', 'donacion', 'saldo_inicial', 'otro')"
        },
        "activos_forma_de_tenencia": {
          "name": "activos_forma_de_tenencia",
          "value": "\"activos_fijos\".\"activos\".\"forma_de_tenencia\" in ('arrendamiento', 'comodato', 'otra')"
        },
        "activos_estado": {
          "name": "activos_estado",
          "value": "\"activos_fijos\".\"activos\".\"estado\" in ('en_construccion', 'en_uso', 'dado_de_baja')"
        },
        "activos_en_construccion_solo_activos": {
          "name": "activos_en_construccion_solo_activos",
          "value": "\"activos_fijos\".\"activos\".\"estado\" <> 'en_construccion' or \"activos_fijos\".\"activos\".\"tipo_de_registro\" = 'activo'"
        },
        "activos_origen_de_terceros": {
          "name": "activos_origen_de_terceros",
          "value": "(\"activos_fijos\".\"activos\".\"tipo_de_registro\" = 'de_terceros') = (\"activos_fijos\".\"activos\".\"origen\" is null)"
        },
        "activos_propietario_de_terceros": {
          "name": "activos_propietario_de_terceros",
          "value": "(\"activos_fijos\".\"activos\".\"tipo_de_registro\" = 'de_terceros') = (\"activos_fijos\".\"activos\".\"propietario\" is not null)"
        },
        "activos_tenencia_de_terceros": {
          "name": "activos_tenencia_de_terceros",
          "value": "(\"activos_fijos\".\"activos\".\"tipo_de_registro\" = 'de_terceros') = (\"activos_fijos\".\"activos\".\"forma_de_tenencia\" is not null)"
        },
        "activos_codigo_valido": {
          "name": "activos_codigo_valido",
          "value": "\"activos_fijos\".\"activos\".\"codigo\" ~ '^[A-Za-z0-9./-]{1,30}$'"
        },
        "activos_descripcion_larga": {
          "name": "activos_descripcion_larga",
          "value": "char_length(btrim(\"activos_fijos\".\"activos\".\"descripcion\")) between 1 and 200"
        },
        "activos_motivo_de_ocio_largo": {
          "name": "activos_motivo_de_ocio_largo",
          "value": "\"activos_fijos\".\"activos\".\"motivo_de_ocio\" is null or char_length(btrim(\"activos_fijos\".\"activos\".\"motivo_de_ocio\")) between 1 and 300"
        },
        "activos_propietario_largo": {
          "name": "activos_propietario_largo",
          "value": "\"activos_fijos\".\"activos\".\"propietario\" is null or char_length(btrim(\"activos_fijos\".\"activos\".\"propietario\")) between 1 and 150"
        },
        "activos_responsable_largo": {
          "name": "activos_responsable_largo",
          "value": "\"activos_fijos\".\"activos\".\"responsable\" is null or char_length(btrim(\"activos_fijos\".\"activos\".\"responsable\")) between 1 and 150"
        },
        "activos_observaciones_largas": {
          "name": "activos_observaciones_largas",
          "value": "\"activos_fijos\".\"activos\".\"observaciones\" is null or char_length(btrim(\"activos_fijos\".\"activos\".\"observaciones\")) between 1 and 500"
        },
        "activos_marca_larga": {
          "name": "activos_marca_larga",
          "value": "\"activos_fijos\".\"activos\".\"marca\" is null or char_length(btrim(\"activos_fijos\".\"activos\".\"marca\")) between 1 and 80"
        },
        "activos_modelo_largo": {
          "name": "activos_modelo_largo",
          "value": "\"activos_fijos\".\"activos\".\"modelo\" is null or char_length(btrim(\"activos_fijos\".\"activos\".\"modelo\")) between 1 and 80"
        },
        "activos_serie_larga": {
          "name": "activos_serie_larga",
          "value": "\"activos_fijos\".\"activos\".\"numero_de_serie\" is null or char_length(btrim(\"activos_fijos\".\"activos\".\"numero_de_serie\")) between 1 and 80"
        },
        "activos_placa_larga": {
          "name": "activos_placa_larga",
          "value": "\"activos_fijos\".\"activos\".\"placa\" is null or char_length(btrim(\"activos_fijos\".\"activos\".\"placa\")) between 1 and 80"
        },
        "activos_ocioso_coherente": {
          "name": "activos_ocioso_coherente",
          "value": "\"activos_fijos\".\"activos\".\"ocioso\" = (\"activos_fijos\".\"activos\".\"ocioso_desde\" is not null and \"activos_fijos\".\"activos\".\"motivo_de_ocio\" is not null)"
        },
        "activos_ocioso_en_uso": {
          "name": "activos_ocioso_en_uso",
          "value": "not \"activos_fijos\".\"activos\".\"ocioso\" or \"activos_fijos\".\"activos\".\"estado\" = 'en_uso'"
        },
        "activos_inicio_de_uso": {
          "name": "activos_inicio_de_uso",
          "value": "(\"activos_fijos\".\"activos\".\"estado\" = 'en_construccion') = (\"activos_fijos\".\"activos\".\"fecha_de_inicio_de_uso\" is null)"
        },
        "activos_fecha_de_baja": {
          "name": "activos_fecha_de_baja",
          "value": "(\"activos_fijos\".\"activos\".\"estado\" = 'dado_de_baja') = (\"activos_fijos\".\"activos\".\"fecha_de_baja\" is not null)"
        },
        "activos_libros_con_uso": {
          "name": "activos_libros_con_uso",
          "value": "(\"activos_fijos\".\"activos\".\"tipo_de_registro\" = 'activo' and \"activos_fijos\".\"activos\".\"estado\" <> 'en_construccion') = (\"activos_fijos\".\"activos\".\"porcentaje_fiscal\" is not null)"
        },
        "activos_porcentaje_fiscal": {
