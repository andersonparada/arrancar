          "name": "clases_terrenos_sin_vida_util",
          "value": "\"activos_fijos\".\"clases\".\"inciso_fiscal\" <> 'terrenos' or \"activos_fijos\".\"clases\".\"vida_util_contable_meses\" is null"
        },
