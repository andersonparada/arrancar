          "name": "clases_terrenos_sin_porcentaje",
          "value": "(\"activos_fijos\".\"clases\".\"inciso_fiscal\" = 'terrenos') = (\"activos_fijos\".\"clases\".\"porcentaje_fiscal\" = 0)"
        },
        "clases_vida_util": {
