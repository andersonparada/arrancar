      "checkConstraints": {
        "documentos_tipo_valido": {
          "name": "documentos_tipo_valido",
          "value": "\"libro_de_ventas\".\"documentos\".\"tipo\" in ('factura', 'factura_cambiaria', 'factura_pequeno_contribuyente', 'factura_pequeno_contribuyente_electronico', 'factura_contribuyente_agropecuario', 'factura_primario_pecuario', 'factura_especial_recibida', 'nota_de_credito', 'nota_de_debito', 'nota_de_abono', 'recibo')"
        },
        "documentos_tipo_dte_de_la_familia": {
          "name": "documentos_tipo_dte_de_la_familia",
          "value": "\"libro_de_ventas\".\"documentos\".\"tipo_dte\" is null or ((\"libro_de_ventas\".\"documentos\".\"tipo\" = 'factura' and \"libro_de_ventas\".\"documentos\".\"tipo_dte\" in ('FACT')) or (\"libro_de_ventas\".\"documentos\".\"tipo\" = 'factura_cambiaria' and \"libro_de_ventas\".\"documentos\".\"tipo_dte\" in ('FCAM')) or (\"libro_de_ventas\".\"documentos\".\"tipo\" = 'factura_pequeno_contribuyente' and \"libro_de_ventas\".\"documentos\".\"tipo_dte\" in ('FPEQ', 'FCAP')) or (\"libro_de_ventas\".\"documentos\".\"tipo\" = 'factura_pequeno_contribuyente_electronico' and \"libro_de_ventas\".\"documentos\".\"tipo_dte\" in ('FAPE', 'FCPE')) or (\"libro_de_ventas\".\"documentos\".\"tipo\" = 'factura_contribuyente_agropecuario' and \"libro_de_ventas\".\"documentos\".\"tipo_dte\" in ('FACA', 'FCCA', 'FAAE', 'FCAE')) or (\"libro_de_ventas\".\"documentos\".\"tipo\" = 'factura_primario_pecuario' and \"libro_de_ventas\".\"documentos\".\"tipo_dte\" in ('FARP', 'FCRP', 'FPEC', 'FCPC')) or (\"libro_de_ventas\".\"documentos\".\"tipo\" = 'factura_especial_recibida' and \"libro_de_ventas\".\"documentos\".\"tipo_dte\" in ('FESP')) or (\"libro_de_ventas\".\"documentos\".\"tipo\" = 'nota_de_credito' and \"libro_de_ventas\".\"documentos\".\"tipo_dte\" in ('NCRE')) or (\"libro_de_ventas\".\"documentos\".\"tipo\" = 'nota_de_debito' and \"libro_de_ventas\".\"documentos\".\"tipo_dte\" in ('NDEB')) or (\"libro_de_ventas\".\"documentos\".\"tipo\" = 'nota_de_abono' and \"libro_de_ventas\".\"documentos\".\"tipo_dte\" in ('NABN')) or (\"libro_de_ventas\".\"documentos\".\"tipo\" = 'recibo' and \"libro_de_ventas\".\"documentos\".\"tipo_dte\" in ('RECI', 'RDON')))"
        },
        "documentos_fel_con_tipo_dte": {
          "name": "documentos_fel_con_tipo_dte",
          "value": "(\"libro_de_ventas\".\"documentos\".\"autorizacion_fel\" is null) = (\"libro_de_ventas\".\"documentos\".\"tipo_dte\" is null)"
        },
        "documentos_origen_valido": {
          "name": "documentos_origen_valido",
          "value": "\"libro_de_ventas\".\"documentos\".\"origen\" in ('manual', 'bandeja_sat', 'fel')"
        },
        "documentos_regimen_iva_valido": {
          "name": "documentos_regimen_iva_valido",
          "value": "\"libro_de_ventas\".\"documentos\".\"regimen_iva_de_la_empresa\" in ('general', 'pequeno_contribuyente', 'pequeno_contribuyente_electronico', 'contribuyente_agropecuario', 'primario_pecuario', 'no_afiliado')"
        },
        "documentos_regimen_isr_valido": {
          "name": "documentos_regimen_isr_valido",
          "value": "\"libro_de_ventas\".\"documentos\".\"regimen_isr_de_la_empresa\" is null or \"libro_de_ventas\".\"documentos\".\"regimen_isr_de_la_empresa\" in ('utilidades', 'opcional_simplificado', 'exento')"
        },
        "documentos_destino_valido": {
          "name": "documentos_destino_valido",
          "value": "\"libro_de_ventas\".\"documentos\".\"destino\" is null or \"libro_de_ventas\".\"documentos\".\"destino\" in ('cuentas-por-cobrar')"
        },
        "documentos_destino_con_cliente": {
          "name": "documentos_destino_con_cliente",
          "value": "\"libro_de_ventas\".\"documentos\".\"destino\" is null or \"libro_de_ventas\".\"documentos\".\"cliente_id\" is not null"
        },
        "documentos_procesado_con_destino": {
          "name": "documentos_procesado_con_destino",
          "value": "\"libro_de_ventas\".\"documentos\".\"procesado_en_destino_en\" is null or \"libro_de_ventas\".\"documentos\".\"destino\" is not null"
        },
        "documentos_recibo_fuera_de_los_reportes": {
          "name": "documentos_recibo_fuera_de_los_reportes",
          "value": "(\"libro_de_ventas\".\"documentos\".\"tipo\" = 'recibo') = (not \"libro_de_ventas\".\"documentos\".\"muestra_en_reportes_sat\")"
        },
        "documentos_serie_valida": {
          "name": "documentos_serie_valida",
          "value": "\"libro_de_ventas\".\"documentos\".\"serie\" is null or (char_length(btrim(\"libro_de_ventas\".\"documentos\".\"serie\")) between 1 and 40 and btrim(\"libro_de_ventas\".\"documentos\".\"serie\") = upper(btrim(\"libro_de_ventas\".\"documentos\".\"serie\")) and btrim(\"libro_de_ventas\".\"documentos\".\"serie\") !~ '\\s')"
        },
        "documentos_numero_valido": {
          "name": "documentos_numero_valido",
          "value": "char_length(btrim(\"libro_de_ventas\".\"documentos\".\"numero\")) between 1 and 40 and btrim(\"libro_de_ventas\".\"documentos\".\"numero\") = upper(btrim(\"libro_de_ventas\".\"documentos\".\"numero\")) and btrim(\"libro_de_ventas\".\"documentos\".\"numero\") !~ '\\s'"
        },
        "documentos_observaciones_largo": {
          "name": "documentos_observaciones_largo",
          "value": "\"libro_de_ventas\".\"documentos\".\"observaciones\" is null or char_length(btrim(\"libro_de_ventas\".\"documentos\".\"observaciones\")) between 1 and 500"
        },
        "documentos_identificacion_valida": {
          "name": "documentos_identificacion_valida",
          "value": "\"libro_de_ventas\".\"documentos\".\"tipo_de_identificacion\" in ('nit', 'cui', 'extranjero', 'cf')"
        },
        "documentos_cf_con_nit_cf": {
          "name": "documentos_cf_con_nit_cf",
          "value": "\"libro_de_ventas\".\"documentos\".\"tipo_de_identificacion\" <> 'cf' or \"libro_de_ventas\".\"documentos\".\"nit_receptor\" = 'CF'"
        },
        "documentos_sin_cliente_es_cf": {
          "name": "documentos_sin_cliente_es_cf",
          "value": "\"libro_de_ventas\".\"documentos\".\"cliente_id\" is not null or \"libro_de_ventas\".\"documentos\".\"nit_receptor\" = 'CF'"
        },
        "documentos_nit_receptor_largo": {
          "name": "documentos_nit_receptor_largo",
          "value": "char_length(btrim(\"libro_de_ventas\".\"documentos\".\"nit_receptor\")) between 1 and 20"
        },
        "documentos_nombre_receptor_largo": {
          "name": "documentos_nombre_receptor_largo",
          "value": "char_length(btrim(\"libro_de_ventas\".\"documentos\".\"nombre_receptor\")) between 1 and 200"
        },
        "documentos_total_positivo": {
          "name": "documentos_total_positivo",
          "value": "\"libro_de_ventas\".\"documentos\".\"total\" > 0"
        },
        "documentos_columnas_no_negativas": {
          "name": "documentos_columnas_no_negativas",
          "value": "\"libro_de_ventas\".\"documentos\".\"gravado_bienes\" >= 0 and \"libro_de_ventas\".\"documentos\".\"gravado_servicios\" >= 0 and \"libro_de_ventas\".\"documentos\".\"exento\" >= 0 and \"libro_de_ventas\".\"documentos\".\"exportacion\" >= 0 and \"libro_de_ventas\".\"documentos\".\"iva\" >= 0 and \"libro_de_ventas\".\"documentos\".\"otros_impuestos\" >= 0"
        },
        "documentos_totales_cuadran": {
          "name": "documentos_totales_cuadran",
          "value": "\"libro_de_ventas\".\"documentos\".\"total\" = \"libro_de_ventas\".\"documentos\".\"gravado_bienes\" + \"libro_de_ventas\".\"documentos\".\"gravado_servicios\" + \"libro_de_ventas\".\"documentos\".\"exento\" + \"libro_de_ventas\".\"documentos\".\"exportacion\" + \"libro_de_ventas\".\"documentos\".\"iva\" + \"libro_de_ventas\".\"documentos\".\"otros_impuestos\""
        },
        "documentos_periodo_es_el_mes_de_emision": {
          "name": "documentos_periodo_es_el_mes_de_emision",
          "value": "\"libro_de_ventas\".\"documentos\".\"periodo\" = date_trunc('month', \"libro_de_ventas\".\"documentos\".\"fecha_emision\")::date"
        },
        "documentos_total_en_moneda_positivo": {
          "name": "documentos_total_en_moneda_positivo",
          "value": "\"libro_de_ventas\".\"documentos\".\"total_en_moneda\" > 0"
        },
        "documentos_quetzales_sin_cambio": {
          "name": "documentos_quetzales_sin_cambio",
          "value": "\"libro_de_ventas\".\"documentos\".\"moneda\" <> 'GTQ' or (\"libro_de_ventas\".\"documentos\".\"tipo_de_cambio\" = 1 and \"libro_de_ventas\".\"documentos\".\"total_en_moneda\" = \"libro_de_ventas\".\"documentos\".\"total\" and \"libro_de_ventas\".\"documentos\".\"fecha_del_tipo_de_cambio\" is null)"
        },
        "documentos_extranjera_con_tipo": {
          "name": "documentos_extranjera_con_tipo",
          "value": "\"libro_de_ventas\".\"documentos\".\"moneda\" = 'GTQ' or (\"libro_de_ventas\".\"documentos\".\"tipo_de_cambio\" > 0 and \"libro_de_ventas\".\"documentos\".\"fecha_del_tipo_de_cambio\" is not null)"
        },
        "documentos_nota_con_factura": {
          "name": "documentos_nota_con_factura",
          "value": "(\"libro_de_ventas\".\"documentos\".\"tipo\" in ('nota_de_credito', 'nota_de_debito', 'nota_de_abono')) = (\"libro_de_ventas\".\"documentos\".\"documento_afectado_id\" is not null or \"libro_de_ventas\".\"documentos\".\"factura_anterior_numero\" is not null)"
        },
        "documentos_una_sola_factura_corregida": {
          "name": "documentos_una_sola_factura_corregida",
          "value": "\"libro_de_ventas\".\"documentos\".\"documento_afectado_id\" is null or \"libro_de_ventas\".\"documentos\".\"factura_anterior_numero\" is null"
        },
        "documentos_factura_anterior_completa": {
          "name": "documentos_factura_anterior_completa",
          "value": "(\"libro_de_ventas\".\"documentos\".\"factura_anterior_numero\" is null) = (\"libro_de_ventas\".\"documentos\".\"factura_anterior_fecha\" is null) and (\"libro_de_ventas\".\"documentos\".\"factura_anterior_serie\" is null or \"libro_de_ventas\".\"documentos\".\"factura_anterior_numero\" is not null)"
        },
        "documentos_estado_valido": {
          "name": "documentos_estado_valido",
          "value": "\"libro_de_ventas\".\"documentos\".\"estado\" in ('vigente', 'anulado')"
        },
        "documentos_anulacion_completa": {
          "name": "documentos_anulacion_completa",
          "value": "(\"libro_de_ventas\".\"documentos\".\"estado\" = 'anulado' and \"libro_de_ventas\".\"documentos\".\"anulado_en\" is not null and \"libro_de_ventas\".\"documentos\".\"anulado_por\" is not null and \"libro_de_ventas\".\"documentos\".\"motivo_de_anulacion\" is not null and \"libro_de_ventas\".\"documentos\".\"causa_de_anulacion\" is not null and \"libro_de_ventas\".\"documentos\".\"fecha_de_anulacion\" is not null)\n        or (\"libro_de_ventas\".\"documentos\".\"estado\" = 'vigente' and \"libro_de_ventas\".\"documentos\".\"anulado_en\" is null and \"libro_de_ventas\".\"documentos\".\"anulado_por\" is null and \"libro_de_ventas\".\"documentos\".\"motivo_de_anulacion\" is null and \"libro_de_ventas\".\"documentos\".\"causa_de_anulacion\" is null and \"libro_de_ventas\".\"documentos\".\"fecha_de_anulacion\" is null)"
        },
        "documentos_causa_valida": {
          "name": "documentos_causa_valida",
          "value": "\"libro_de_ventas\".\"documentos\".\"causa_de_anulacion\" is null or \"libro_de_ventas\".\"documentos\".\"causa_de_anulacion\" in ('fel_anulada_en_la_sat', 'error_de_captura', 'no_corresponde_a_la_empresa')"
        },
        "documentos_motivo_de_anulacion_largo": {
          "name": "documentos_motivo_de_anulacion_largo",
