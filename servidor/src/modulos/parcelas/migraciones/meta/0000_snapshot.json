        }
      },
      "checkConstraints": {
        "mediciones_fuente_valida": {
          "name": "mediciones_fuente_valida",
          "value": "\"parcelas\".\"mediciones\".\"fuente\" in ('escritura', 'plano_topografico', 'gps', 'estimacion', 'otra')"
        },
        "mediciones_superficie_valida": {
          "name": "mediciones_superficie_valida",
          "value": "\"parcelas\".\"mediciones\".\"superficie_total_m2\" > 0 and \"parcelas\".\"mediciones\".\"superficie_util_m2\" > 0 and \"parcelas\".\"mediciones\".\"superficie_util_m2\" <= \"parcelas\".\"mediciones\".\"superficie_total_m2\""
        },
        "mediciones_cantidad_positiva": {
          "name": "mediciones_cantidad_positiva",
          "value": "\"parcelas\".\"mediciones\".\"cantidad_original\" > 0"
        },
        "mediciones_unidad_valida": {
          "name": "mediciones_unidad_valida",
          "value": "\"parcelas\".\"mediciones\".\"unidad_original\" in ('m2', 'hectarea', 'manzana', 'cuerda', 'vara_cuadrada', 'caballeria')"
        },
        "mediciones_varas_validas": {
          "name": "mediciones_varas_validas",
          "value": "(\"parcelas\".\"mediciones\".\"unidad_original\" = 'cuerda') = (\"parcelas\".\"mediciones\".\"varas_por_lado_de_cuerda\" is not null) and (\"parcelas\".\"mediciones\".\"varas_por_lado_de_cuerda\" is null or \"parcelas\".\"mediciones\".\"varas_por_lado_de_cuerda\" between 1 and 100)"
        },
        "mediciones_documento_valido": {
          "name": "mediciones_documento_valido",
          "value": "\"parcelas\".\"mediciones\".\"documento\" is null or char_length(trim(\"parcelas\".\"mediciones\".\"documento\")) between 1 and 150"
        },
        "mediciones_estado_valido": {
          "name": "mediciones_estado_valido",
          "value": "\"parcelas\".\"mediciones\".\"estado\" in ('vigente', 'anulada')"
        },
        "mediciones_anulacion_completa": {
          "name": "mediciones_anulacion_completa",
          "value": "(\"parcelas\".\"mediciones\".\"estado\" = 'anulada') = (\"parcelas\".\"mediciones\".\"anulada_en\" is not null and \"parcelas\".\"mediciones\".\"anulada_por\" is not null and \"parcelas\".\"mediciones\".\"motivo_de_anulacion\" is not null)"
        },
        "mediciones_motivo_valido": {
          "name": "mediciones_motivo_valido",
          "value": "\"parcelas\".\"mediciones\".\"motivo_de_anulacion\" is null or char_length(trim(\"parcelas\".\"mediciones\".\"motivo_de_anulacion\")) between 1 and 300"
        }
      },
      "isRLSEnabled": false
    },
