        "articulos_tipo_de_inventario": {
          "name": "articulos_tipo_de_inventario",
          "value": "\"inventarios\".\"articulos\".\"tipo_de_inventario\" in ('mercaderia', 'materia_prima', 'suministros', 'producto_en_proceso', 'producto_terminado', 'repuestos', 'empaques')"
        },
        "articulos_vencimiento_con_lotes": {
          "name": "articulos_vencimiento_con_lotes",
          "value": "not \"inventarios\".\"articulos\".\"maneja_vencimiento\" or \"inventarios\".\"articulos\".\"maneja_lotes\""
        },
        "articulos_codigo_de_barras_largo": {
          "name": "articulos_codigo_de_barras_largo",
          "value": "char_length(\"inventarios\".\"articulos\".\"codigo_de_barras\") between 1 and 60"
        },
        "articulos_existencia_minima": {
          "name": "articulos_existencia_minima",
          "value": "\"inventarios\".\"articulos\".\"existencia_minima\" >= 0"
        },
        "articulos_peso_positivo": {
          "name": "articulos_peso_positivo",
          "value": "\"inventarios\".\"articulos\".\"peso_kg_por_unidad_base\" > 0"
        }
      },
